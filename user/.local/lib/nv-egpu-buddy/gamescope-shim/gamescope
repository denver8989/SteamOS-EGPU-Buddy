#!/usr/bin/env bash
set -euo pipefail

gamescope_bin=${NV_EGPU_BUDDY_GAMESCOPE_BIN:-/usr/bin/gamescope}
format_filter=${NV_EGPU_GAMESCOPE_FORMAT_FILTER:-/home/deck/.local/lib/nv-egpu-buddy/nv-egpu-gamescope-format-filter.so}
format_filter_enable=${NV_EGPU_GAMESCOPE_FORMAT_FILTER_ENABLE:-0}
add_disable_layers=${NV_EGPU_GAMESCOPE_DISABLE_LAYERS:-1}
add_force_composition=${NV_EGPU_GAMESCOPE_FORCE_COMPOSITION:-1}
add_disable_color_management=${NV_EGPU_GAMESCOPE_DISABLE_COLOR_MANAGEMENT:-1}
add_output_width=1
add_output_height=1
add_nested_width=1
add_nested_height=1
add_nested_refresh=1

for arg in "$@"; do
  case "$arg" in
    --disable-layers) add_disable_layers=0 ;;
    --force-composition) add_force_composition=0 ;;
    --disable-color-management) add_disable_color_management=0 ;;
    -W|--output-width) add_output_width=0 ;;
    -H|--output-height) add_output_height=0 ;;
    -w|--nested-width) add_nested_width=0 ;;
    -h|--nested-height) add_nested_height=0 ;;
    -r|--nested-refresh) add_nested_refresh=0 ;;
  esac
done

# Native Steam canvas on the eGPU display: the inner (Steam UI / game) size must follow the staged OUTPUT size. gamescope
# does that by itself when no -w/-h is given, which is what the CachyOS session script does. Valve's SteamOS script always
# passes "-w 1280 -h 800", and Steam then settles on 1920x1080 on a 5120x1440 monitor (seen on a real device). So in this
# mode the session's inner size is dropped; nothing here depends on the distro, only on what was passed.
if [ "${NV_EGPU_GAMESCOPE_NATIVE_STEAM_CANVAS:-0}" = 1 ] && [ -n "${NV_EGPU_GAMESCOPE_OUTPUT_WIDTH:-}" ] && [ -z "${NV_EGPU_GAMESCOPE_NESTED_WIDTH:-}" ]; then
  _keep=(); _skip=0
  for arg in "$@"; do
    if [ "$_skip" = 1 ]; then _skip=0; continue; fi
    case "$arg" in -w|-h|--nested-width|--nested-height) _skip=1; continue ;; esac
    _keep+=("$arg")
  done
  set -- "${_keep[@]}"
fi

# HDR output: gamescope maps SDR content (the whole Steam UI) at its default 400 nits, which on a real HDR monitor looks
# washed out and grey (seen on the Legion Go 1; the user could only fix it by switching HDR off). 203 nits is the reference
# SDR white for HDR signals. Opt in with NV_EGPU_GAMESCOPE_HDR_SDR_NITS=<n>; unset keeps gamescope's own default, so no
# machine changes behaviour by upgrading.
if [ -n "${NV_EGPU_GAMESCOPE_HDR_SDR_NITS:-}" ] && [[ " $* " != *" --hdr-sdr-content-nits "* ]]; then
  set -- --hdr-sdr-content-nits "$NV_EGPU_GAMESCOPE_HDR_SDR_NITS" "$@"
fi

prefix=()
[ "$add_disable_layers" -eq 0 ] || prefix+=(--disable-layers)
[ "$add_force_composition" -eq 0 ] || prefix+=(--force-composition)
[ "$add_disable_color_management" -eq 0 ] || prefix+=(--disable-color-management)
if [ -n "${NV_EGPU_GAMESCOPE_OUTPUT_WIDTH:-}" ] && [ -n "${NV_EGPU_GAMESCOPE_OUTPUT_HEIGHT:-}" ]; then
  if [ "$add_output_width" -eq 1 ]; then
    prefix+=(-W "$NV_EGPU_GAMESCOPE_OUTPUT_WIDTH")
  fi
  if [ "$add_output_height" -eq 1 ]; then
    prefix+=(-H "$NV_EGPU_GAMESCOPE_OUTPUT_HEIGHT")
  fi
fi
if [ -n "${NV_EGPU_GAMESCOPE_NESTED_WIDTH:-}" ] && [ -n "${NV_EGPU_GAMESCOPE_NESTED_HEIGHT:-}" ]; then
  if [ "$add_nested_width" -eq 1 ]; then
    prefix+=(-w "$NV_EGPU_GAMESCOPE_NESTED_WIDTH")
  fi
  if [ "$add_nested_height" -eq 1 ]; then
    prefix+=(-h "$NV_EGPU_GAMESCOPE_NESTED_HEIGHT")
  fi
fi
if [ -n "${NV_EGPU_GAMESCOPE_NESTED_REFRESH:-}" ] && [ "$add_nested_refresh" -eq 1 ]; then
  prefix+=(-r "$NV_EGPU_GAMESCOPE_NESTED_REFRESH")
fi

if [ "$format_filter_enable" = "1" ] && [ -r "$format_filter" ] &&
  { [ "${NV_EGPU_GAMESCOPE_FORCE_8BIT:-0}" != "0" ] ||
    [ "${NV_EGPU_GAMESCOPE_FORCE_LINEAR:-0}" != "0" ] ||
    [ "${NV_EGPU_GAMESCOPE_DISABLE_MODIFIERS:-0}" != "0" ] ||
    [ "${NV_EGPU_GAMESCOPE_HDMI_REDUCED_BLANKING:-0}" != "0" ] ||
    [ "${NV_EGPU_GAMESCOPE_MAX_BLOCK_HEIGHT:-0}" != "0" ]; }; then
  case ":${LD_PRELOAD:-}:" in
    *":$format_filter:"*) ;;
    ::) export LD_PRELOAD="$format_filter" ;;
    *) export LD_PRELOAD="$format_filter:${LD_PRELOAD:-}" ;;
  esac
fi

# ponytail: private GBM-scanout build (see packaging/gamescope-gbm) may stop linking after a system
# library bump -> fall back to the stock binary instead of crash-looping the session.
if [ "$gamescope_bin" != /usr/bin/gamescope ] && { [ ! -x "$gamescope_bin" ] || ldd "$gamescope_bin" 2>/dev/null | grep -q 'not found'; }; then
  echo "nv-egpu-gamescope-shim: $gamescope_bin not runnable, falling back to /usr/bin/gamescope" >&2
  gamescope_bin=/usr/bin/gamescope
  unset gamescope_drm_gbm_scanout
fi
# A gamescope with file capabilities (the distro's: cap_sys_nice) runs the Vulkan loader in "secure" mode, which IGNORES
# VK_DRIVER_FILES / VK_ICD_FILENAMES: the session's NVIDIA-only routing never reaches it and it composites on the built-in
# GPU and opens ITS display node (seen on SteamOS, where the private build cannot run). A command-line option cannot be
# stripped: name the eGPU explicitly; gamescope opens the KMS node that belongs to the Vulkan device it chose.
case "${VK_DRIVER_FILES:-}${VK_ICD_FILENAMES:-}" in *nvidia*)
  if [ -n "$(getcap "$gamescope_bin" 2>/dev/null)" ] && [[ " $* " != *" --prefer-vk-device "* ]]; then
    read -r _bdf _ < <(/usr/local/sbin/egpu-detect 2>/dev/null) || _bdf=""
    if [ -n "$_bdf" ]; then _v=$(cat "/sys/bus/pci/devices/$_bdf/vendor" 2>/dev/null); _d=$(cat "/sys/bus/pci/devices/$_bdf/device" 2>/dev/null)
      [ -n "$_v" ] && [ -n "$_d" ] && prefix+=(--prefer-vk-device "${_v#0x}:${_d#0x}"); fi
  fi ;;
esac
exec "$gamescope_bin" "${prefix[@]}" "$@"
