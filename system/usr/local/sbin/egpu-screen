#!/usr/bin/env python3
"""egpu-screen - read and wake external screens over DDC/CI (HDMI and DisplayPort).

  egpu-screen list              one line per connected external screen
  egpu-screen state CONNECTOR   exit 0 in use / unknown, 1 = on another input
  egpu-screen wake [CONNECTOR]  power on screens still on our input (all if none given)
  egpu-screen wake --input ...  also switch screens on another input back to us
  egpu-screen settle            the only external screen? turn it on and onto our input
  egpu-screen replug [CONNECTOR] desktop only: software unplug + replug, for a monitor stuck on "no signal"
  egpu-screen watch             desktop session: settle on plug-in; with 2+ screens, leave a TV that is
                                on another input (or off) out of the desktop until it is switched to us

Two cable standards, any brand: DDC/CI (monitors, some TVs; read directly, no ddcutil) and
HDMI-CEC (TVs) through the kernel's /dev/cec* when the connection exposes it (AMD/Intel DP-CEC
tunnelling on USB-C/DP->HDMI adapters, USB-CEC adapters; NVIDIA exposes none) via cec-ctl.
A screen that answers neither reads "unknown" and is treated as in use - never hidden on a guess.
"""
import fcntl, glob, json, os, re, subprocess, sys, time

I2C_SLAVE = 0x0703
STORE = "/var/lib/nvegpu/screen-inputs.json"  # EDID -> input code seen while in use
ADAPTERS = re.compile(r"NVIDIA i2c adapter|AMDGPU DM|i915 gmbus|DPDDC|nvkm|radeon", re.I)
INPUTS = {0x01: "VGA", 0x03: "DVI", 0x04: "DVI", 0x0F: "DisplayPort-1", 0x10: "DisplayPort-2",
          0x11: "HDMI-1", 0x12: "HDMI-2", 0x13: "HDMI-3", 0x14: "HDMI-4",
          0x1B: "USB-C", 0x1C: "USB-C-2"}


def _bus(n, addr):
    fd = os.open(f"/dev/i2c-{n}", os.O_RDWR)
    fcntl.ioctl(fd, I2C_SLAVE, addr)
    return fd


def _edid(n):
    try:
        fd = _bus(n, 0x50)
        try:
            os.write(fd, b"\0")
            return os.read(fd, 128)
        finally:
            os.close(fd)
    except OSError:
        return b""


def _ddc(n, payload, reply=0):
    msg = bytes([0x51, 0x80 | len(payload)]) + payload
    chk = 0x6E
    for b in msg:
        chk ^= b
    fd = _bus(n, 0x37)
    try:
        os.write(fd, msg + bytes([chk]))
        time.sleep(0.06)
        return os.read(fd, reply) if reply else b""
    finally:
        os.close(fd)


def getvcp(n, code):
    for _ in range(3):
        try:
            r = _ddc(n, bytes([0x01, code]), 11)
            if len(r) == 11 and r[2] == 0x02 and r[3] == 0 and r[4] == code:
                return (r[8] << 8) | r[9]
        except OSError:
            pass
        time.sleep(0.05)
    return None


def setvcp(n, code, value):
    try:
        _ddc(n, bytes([0x03, code, value >> 8, value & 0xFF]))
        return True
    except OSError:
        return False


def screens():
    """Yield (connector, bus or None, edid) for every connected non-panel output."""
    buses = {}
    for d in glob.glob("/sys/bus/i2c/devices/i2c-*"):
        try:
            if ADAPTERS.search(open(d + "/name").read()):
                n = int(d.rsplit("-", 1)[1])
                e = _edid(n)
                if len(e) == 128:
                    buses.setdefault(e, n)
        except (OSError, ValueError):
            pass
    for node in sorted(glob.glob("/sys/class/drm/card*-*")):
        conn = re.sub(r"^card\d+-", "", os.path.basename(node))
        if conn.startswith(("eDP", "LVDS", "DSI", "Writeback")):
            continue
        try:
            if open(node + "/status").read().strip() != "connected":
                continue
            edid = open(node + "/edid", "rb").read()[:128]
        except OSError:
            continue
        yield conn, buses.get(edid), edid


def _store(update=None):
    try:
        data = json.load(open(STORE))
    except (OSError, ValueError):
        data = {}
    if update:
        data.update(update)
        try:
            os.makedirs(os.path.dirname(STORE), exist_ok=True)
            json.dump(data, open(STORE, "w"))
        except OSError:
            pass
    return data


def edid_name(edid):
    i = edid.find(b"\0\0\0\xfc\0")
    return edid[i + 5:i + 18].split(b"\n")[0].decode(errors="ignore").strip() if i >= 0 else ""


def _cec_for(conn):
    """/dev/cecN whose parent is this DRM connector (DP-CEC tunnel), or the only CEC adapter for an HDMI port."""
    devs = glob.glob("/sys/class/cec/cec*")
    for d in devs:
        if re.sub(r"^card\d+-", "", os.path.basename(os.path.realpath(d + "/device"))) == conn:
            return "/dev/" + os.path.basename(d)
    # ponytail: a lone USB-CEC adapter is assumed to sit on the HDMI screen; map by phys addr if two ever exist
    return "/dev/" + os.path.basename(devs[0]) if len(devs) == 1 and conn.startswith("HDMI") else None


def _cec(dev, *args):
    try:
        return subprocess.run(["cec-ctl", "-d", dev, *args], capture_output=True, text=True, timeout=6).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def cec_read(dev):
    """-> (power, ours) ; power on|standby|None, ours True/False/None (is the TV showing our source?)"""
    info = _cec(dev, "--playback")  # claim a playback logical address (idempotent)
    me = re.search(r"Physical Address\s*:\s*([0-9a-f.]+)", info)
    pw = re.search(r"pwr-state:\s*(\w+)", _cec(dev, "--to", "0", "--give-device-power-status"))
    src = re.search(r"phys-addr:\s*([0-9a-f.]+)", _cec(dev, "--to", "15", "--request-active-source",
                                                          "--wait-for-msgs", "--monitor-time", "2"))
    # the active source answers by broadcast; the TV itself answers 0.0.0.0 while showing its tuner/apps
    power = {"on": "on", "standby": "standby"}.get(pw.group(1)) if pw else None
    ours = (src.group(1) == me.group(1)) if (src and me) else None
    return power, ours


def cec_wake(dev, take_input):
    me = re.search(r"Physical Address\s*:\s*([0-9a-f.]+)", _cec(dev, "--playback"))
    _cec(dev, "--to", "0", "--image-view-on")  # TV on (and, per spec, to us)
    if take_input and me:
        _cec(dev, "--active-source", f"phys-addr={me.group(1)}")
    return "woken (CEC)"


def read(conn, bus, edid):
    """-> (state, power, input) ; state = in-use | other-input | off | standby | unknown"""
    cec = _cec_for(conn)
    if cec:
        power, ours = cec_read(cec)
        if power == "standby":
            return "off", power, None
        if power == "on" and ours is not None:
            return ("in-use" if ours else "other-input"), power, None
    if bus is None:
        return "unknown", None, None
    power, src = getvcp(bus, 0xD6), getvcp(bus, 0x60)
    if src is not None:
        src &= 0xFF  # high byte is vendor noise on some screens
    name = INPUTS.get(src, "")
    # Only certain cases count: an HDMI signal can only land on an HDMI input. A DP output can reach an
    # HDMI input through an adapter, so DP + "HDMI" is NOT proof of another input. Same-type inputs
    # (HDMI 1 vs HDMI 2) look alike over DDC/CI - telling those apart is what the CEC path is for.
    if conn.startswith("HDMI") and name and not name.startswith("HDMI"):
        return "other-input", power, src
    if src is not None and (conn.startswith("HDMI") and name.startswith("HDMI")
                            or conn.startswith("DP") and name.startswith(("DisplayPort", "USB-C"))):
        _store({conn + ":" + edid.hex(): src})  # certainly ours: what Wake switches back to
    if power in (2, 3, 4, 5):
        return "standby", power, src
    return ("in-use" if src is not None or power == 1 else "unknown"), power, src


def wake(conn, bus, edid, take_input=False):
    cec = _cec_for(conn)
    if cec:
        if not take_input and read(conn, bus, edid)[0] == "other-input":
            return "on another input - left alone"
        return cec_wake(cec, take_input)
    if bus is None:
        return "no DDC/CI - can't wake"
    st = read(conn, bus, edid)[0]
    if st == "other-input" and not take_input:
        return "on another input - left alone"
    ok = setvcp(bus, 0xD6, 1)
    src = _store().get(conn + ":" + edid.hex())
    if take_input and src is not None and getvcp(bus, 0x60) not in (None, src):
        ok = setvcp(bus, 0x60, src) and ok
    return "woken" if ok else "write failed"


def settle():
    """Only one external screen: it is the one to use, so turn it on and bring it to our input."""
    found = list(screens())
    if len(found) == 1 and read(*found[0])[0] in ("other-input", "off", "standby"):
        print(found[0][0], wake(*found[0], take_input=True))


def _kwin_enable(conn, on):
    os.system(f"kscreen-doctor output.{conn}.{'enable' if on else 'disable'} >/dev/null 2>&1")


def watch():
    """Desktop (KWin) only - Game Mode picks its screens at attach (nv-egpu-buddy-mount)."""
    names, last, ours = set(), {}, set()
    if subprocess.run(["which", "kscreen-doctor"], capture_output=True).returncode:
        print("no kscreen-doctor (not KDE Plasma): desktop screen rule off", flush=True); return
    while True:
        if os.system("pgrep -x 'gamescope(-wl)?' >/dev/null") != 0:
            found = list(screens())
            now = {f[0] for f in found}
            if now - names:
                settle()  # something was plugged in
            names = now
            if len(found) > 1:
                for conn, bus, edid in found:
                    st = read(conn, bus, edid)[0]
                    if st == "unknown" and conn in last:
                        continue  # a read that failed this time is not news
                    if st == last.get(conn):
                        continue  # act on changes only, so a manual KDE change is never fought
                    last[conn] = st
                    use = st not in ("other-input", "off")
                    enabled = any(open(n).read().strip() == "enabled" for n in glob.glob(f"/sys/class/drm/card*-{conn}/enabled"))
                    others = [c for c, _, _ in found if c != conn and any(open(n).read().strip() == "enabled"
                              for n in glob.glob(f"/sys/class/drm/card*-{c}/enabled"))]
                    # Only ever undo our own change: re-enable a screen this watcher disabled, never one KDE (or
                    # the user) turned off. A KDE-side output toggle on the eGPU can leave the link dark.
                    if not use and enabled and others:  # never switch off the last lit screen
                        print(f"{conn}: {st} -> disable", flush=True)
                        _kwin_enable(conn, False); ours.add(conn)
                    elif use and not enabled and conn in ours:
                        print(f"{conn}: {st} -> enable (we disabled it)", flush=True)
                        _kwin_enable(conn, True); ours.discard(conn)
        time.sleep(5)


def main(argv):
    cmd, want = (argv[1] if len(argv) > 1 else "list"), argv[2:]
    take_input = "--input" in want
    want = [w for w in want if w != "--input"]
    found = [s for s in screens() if not want or s[0] in want]
    if cmd == "list":
        for conn, bus, edid in found:
            st, power, src = read(conn, bus, edid)
            print(json.dumps({"connector": conn, "state": st, "ddc": bus is not None,
                              "input": INPUTS.get(src, src), "power": power,
                              "name": edid_name(edid)}))
        return 0
    if cmd == "state":
        if not found:
            print("disconnected"); return 0
        st = read(*found[0])[0]
        print(st)
        return 1 if st == "other-input" else 0
    if cmd == "wake":
        for s in found:
            print(s[0], wake(*s, take_input=take_input))
        return 0
    if cmd == "replug":
        # Software unplug + replug: the screen drops out of the compositor and comes back with a fresh link training.
        # Brings back a DisplayPort monitor that sits in "no signal" while the GPU is scanning out to it (seen on the
        # NVIDIA eGPU after a desktop re-login; before, only pulling the cable fixed it). Desktop only: what gamescope
        # does when its screen vanishes is untested.
        if os.system("pgrep -x 'gamescope(-wl)?' >/dev/null") == 0:
            print("Game Mode is running: replug is desktop-only"); return 1
        for conn, _, _ in found:
            for st in glob.glob(f"/sys/class/drm/card*-{conn}/status"):
                open(st, "w").write("off"); time.sleep(3); open(st, "w").write("detect")
            print(conn, "replugged")
        return 0
    if cmd == "settle":
        settle(); return 0
    if cmd == "watch":
        watch()
    if cmd == "selftest":  # the input rule without hardware: (connector, power, input) -> state
        global getvcp, _store
        real = getvcp, _store
        _store = lambda update=None: {}
        for conn, power, src, want in [("HDMI-A-1", 1, 0x0F, "other-input"), ("HDMI-A-1", 1, 0x11, "in-use"),
                                       ("DP-7", 1, 0x12, "in-use"),  # DP->HDMI adapter: not proof of another input
                                       ("HDMI-A-1", 1, 0x1B, "other-input"), ("DP-7", 1, 0x10, "in-use"),
                                       ("DP-7", 1, 0x1B, "in-use"), ("DP-7", 4, 0x10, "standby"),
                                       ("HDMI-A-1", None, None, "unknown")]:
            getvcp = lambda n, c, p=power, i=src: p if c == 0xD6 else i
            got = read(conn, 0, b"")[0]
            assert got == want, (conn, power, src, got, want)
        assert read("HDMI-A-1", None, b"")[0] == "unknown"
        getvcp, _store = real
        print("ok"); return 0
    print(__doc__); return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
