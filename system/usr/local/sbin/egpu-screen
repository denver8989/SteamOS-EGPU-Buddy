                             "UPDATE_FROM_REMOTE_APP", "READ_LGE_TV_INPUT_EVENTS", "READ_TV_CURRENT_TIME"],
             "serial": "2f930e2d2cfe083771f68e4fe7bb07", "vendorId": "com.lge"}  # public manifest every LG remote app uses
# only what we use: power state + current input (read), screen on + input switch (write)
LG_PERMS = ["CONTROL_POWER", "CONTROL_TV_SCREEN", "CONTROL_INPUT_TV", "READ_POWER_STATE", "READ_INPUT_DEVICE_LIST",
            "READ_APP_STATUS", "READ_RUNNING_APPS"]


class WS:
    """Just enough RFC 6455 for webOS: text frames, client masking, ping/pong."""
    def __init__(self, host, timeout=3):
        try:
            raw = socket.create_connection((host, 3001), timeout)
            ctx = ssl.create_default_context(); ctx.check_hostname = False; ctx.verify_mode = ssl.CERT_NONE
            self.s, port = ctx.wrap_socket(raw, server_hostname=host), 3001  # webOS self-signed cert
        except (OSError, ssl.SSLError):
            self.s, port = socket.create_connection((host, 3000), timeout), 3000
        key = base64.b64encode(os.urandom(16)).decode()
        self.s.sendall((f"GET / HTTP/1.1\r\nHost: {host}:{port}\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
                        f"Sec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n").encode())
        head = b""
        while b"\r\n\r\n" not in head:
            c = self.s.recv(1)
            if not c:
                raise OSError("closed during handshake")
            head += c
        if b" 101 " not in head.split(b"\r\n")[0]:
            raise OSError("websocket refused")

    def _recvn(self, n):
        b = b""
        while len(b) < n:
            c = self.s.recv(n - len(b))
            if not c:
                raise OSError("closed")
            b += c
        return b

    def send(self, obj, op=1):
        data = json.dumps(obj).encode() if op == 1 else obj
        n, mask = len(data), os.urandom(4)
        hdr = bytes([0x80 | op]) + (bytes([0x80 | n]) if n < 126 else bytes([0xFE]) + n.to_bytes(2, "big") if n < 65536
                                   else bytes([0xFF]) + n.to_bytes(8, "big"))
        self.s.sendall(hdr + mask + bytes(b ^ mask[i % 4] for i, b in enumerate(data)))

    def recv(self):
        msg = b""
        while True:
            b0, b1 = self._recvn(2)
            n = b1 & 0x7F
            n = int.from_bytes(self._recvn(2 if n == 126 else 8), "big") if n >= 126 else n
            data = self._recvn(n)
            op = b0 & 0x0F
            if op == 9:
                self.send(data, 10); continue
            if op == 8:
                raise OSError("closed")
            msg += data
            if b0 & 0x80:
                return json.loads(msg)

    def call(self, uri, payload=None, _id=[0]):
        _id[0] += 1
        rid = f"r{_id[0]}"
        self.send({"type": "request", "id": rid, "uri": "ssap://" + uri, **({"payload": payload} if payload else {})})
        while True:
            m = self.recv()
            if m.get("id") == rid:
                return m.get("payload", {}) if m.get("type") == "response" else {"error": m.get("error")}


def lg_conf():
    try:
        return json.load(open(LG_CONF))
    except (OSError, ValueError):
        return {}


def lg_open(c, timeout=3):
    ws = WS(c["host"], timeout)
    ws.send({"type": "register", "id": "reg", "payload": {"forcePairing": False, "pairingType": "PROMPT", "client-key": c.get("key", ""),
             "manifest": {"manifestVersion": 1, "appVersion": "1.1", "signed": LG_SIGNED, "permissions": LG_PERMS,
                          "signatures": [{"signatureVersion": 1, "signature": LG_SIG}]}}})
    while True:
        m = ws.recv()
        if m.get("type") == "registered":
            return ws, m["payload"].get("client-key")
        if m.get("type") == "error":
            raise OSError(m.get("error"))


def lg_read(c):
    """-> (power, input) ; power: on | screen-off | standby | off ; input e.g. HDMI_2 (None if unknown)."""
    try:
        ws, _ = lg_open(c)
    except (OSError, ValueError):
        return "off", None  # network stack down = TV fully off (or unplugged from the network)
    try:
        st = ws.call("com.webos.service.tvpower/power/getPowerState").get("state", "Active")
        app = ws.call("com.webos.applicationManager/getForegroundAppInfo").get("appId", "")
    finally:
        ws.s.close()
    m = re.match(r"com\.webos\.app\.hdmi(\d)$", app)
    power = {"Active": "on", "Screen Off": "screen-off"}.get(st, "standby")
    return power, (f"HDMI_{m.group(1)}" if m else app or None)


def lg_wake(c):  # power on (Wake-on-LAN + screen on), then switch to c["input"] if set
    mac = bytes.fromhex(c.get("mac", "").replace(":", ""))
    if len(mac) == 6:  # Wake-on-LAN: TV setting "Turn on via Wi-Fi" must be on
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM); s.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        for _ in range(3):
            s.sendto(b"\xff" * 6 + mac * 16, ("255.255.255.255", 9))
        s.close()
    for _ in range(20):  # the TV's network stack takes a few seconds after WoL
        try:
            ws, _ = lg_open(c); break
        except (OSError, ValueError):
            time.sleep(1)
    else:
        return "TV not reachable on the network"
    try:
        if ws.call("com.webos.service.tvpower/power/getPowerState").get("state") == "Screen Off":
            ws.call("com.webos.service.tvpower/power/turnOnScreen", {"standbyMode": "active"})
        if c.get("input"):
            ws.call("tv/switchInput", {"inputId": c["input"]})
    finally:
        ws.s.close()
    return "woken"


def lg_pair(host):
    c = {"host": host}
    ws, key = lg_open(c, timeout=60)  # blocks on the TV's "allow?" prompt
    c["key"] = key
    inputs = ws.call("tv/getExternalInputList").get("devices", [])
    power, cur = lg_read(c)
    ws.s.close()
    try:
        c["mac"] = open("/proc/net/arp").read().split(host + " ", 1)[1].split()[2]
    except (OSError, IndexError):
        pass
    c["inputs"] = [{k: d.get(k) for k in ("id", "label", "connected")} for d in inputs]
    # pair with the TV switched to the eGPU's HDMI: the input it shows now is remembered as ours
    if cur and cur.startswith("HDMI_"):
        c["input"] = cur
    os.makedirs(os.path.dirname(LG_CONF), exist_ok=True)
    json.dump(c, open(LG_CONF, "w"), indent=1)
    os.chmod(LG_CONF, 0o640); os.chown(LG_CONF, 0, 1000)  # readable by the desktop watcher (runs as the user)
    return c


def screens():
    """Yield (connector, bus or None, edid) for every connected non-panel output."""
    buses = {}
    for d in glob.glob("/sys/bus/i2c/devices/i2c-*"):
        try:
            if ADAPTERS.search(open(d + "/name").read()):
                n = int(d.rsplit("-", 1)[1])
                e = _edid(n)
                if len(e) == 128:
                    buses.setdefault(e, n)
        except (OSError, ValueError):
            pass
    for node in sorted(glob.glob("/sys/class/drm/card*-*")):
        conn = re.sub(r"^card\d+-", "", os.path.basename(node))
        if conn.startswith(("eDP", "LVDS", "DSI", "Writeback")):
            continue
        try:
            if open(node + "/status").read().strip() != "connected":
                continue
            edid = open(node + "/edid", "rb").read()[:128]
        except OSError:
            continue
        yield conn, buses.get(edid), edid


def _store(update=None):
    try:
        data = json.load(open(STORE))
    except (OSError, ValueError):
        data = {}
    if update:
        data.update(update)
        try:
            os.makedirs(os.path.dirname(STORE), exist_ok=True)
            json.dump(data, open(STORE, "w"))
        except OSError:
            pass
    return data


def edid_name(edid):
    i = edid.find(b"\0\0\0\xfc\0")
    return edid[i + 5:i + 18].split(b"\n")[0].decode(errors="ignore").strip() if i >= 0 else ""


def _lg_for(edid):
    # ponytail: one paired LG TV per machine, matched by EDID name; key it by EDID if someone has two
    c = lg_conf()
    return c if c.get("key") and edid_name(edid).startswith("LG TV") else None


def read(conn, bus, edid):
    """-> (state, power, input) ; state = in-use | other-input | off | standby | unknown"""
    lg = _lg_for(edid)
    if lg:
        power, src = lg_read(lg)
        if power != "on":
            return "off", power, src
        return ("other-input" if lg.get("input") and src != lg["input"] else "in-use"), power, src
    if bus is None:
        return "unknown", None, None
    power, src = getvcp(bus, 0xD6), getvcp(bus, 0x60)
    if src is not None:
        src &= 0xFF  # high byte is vendor noise on some screens
    name = INPUTS.get(src, "")
    # ponytail: type match only (HDMI connector vs DP/USB-C input); a monitor with two DP inputs
    # on the other DP one reads "in use" - fine, it just wakes up to us.
    wrong = (conn.startswith("HDMI") and name and not name.startswith("HDMI")) or \
            (conn.startswith("DP") and name.startswith("HDMI"))
    if wrong:
        return "other-input", power, src
    if src is not None:
        _store({edid.hex(): src})
    if power in (2, 3, 4, 5):
        return "standby", power, src
    return ("in-use" if src is not None or power == 1 else "unknown"), power, src


def wake(conn, bus, edid, take_input=False):
    lg = _lg_for(edid)
    if lg:
        if not take_input and read(conn, bus, edid)[0] == "other-input":
            return "on another input - left alone"
        return lg_wake(lg if take_input else {**lg, "input": None})
    if bus is None:
        return "no DDC/CI - can't wake"
    st = read(conn, bus, edid)[0]
    if st == "other-input" and not take_input:
        return "on another input - left alone"
    ok = setvcp(bus, 0xD6, 1)
    src = _store().get(edid.hex())
    if take_input and src is not None and getvcp(bus, 0x60) not in (None, src):
        ok = setvcp(bus, 0x60, src) and ok
    return "woken" if ok else "write failed"


def settle():
    """Only one external screen: it is the one to use, so turn it on and bring it to our input."""
    found = list(screens())
    if len(found) == 1 and read(*found[0])[0] in ("other-input", "off", "standby"):
        print(found[0][0], wake(*found[0], take_input=True))


def _kwin_enable(conn, on):
    os.system(f"kscreen-doctor output.{conn}.{'enable' if on else 'disable'} >/dev/null 2>&1")


def watch():
    """Desktop (KWin) only - Game Mode picks its screens at attach (nv-egpu-buddy-mount)."""
    names, last = set(), {}
    while True:
        if os.system("pgrep -x 'gamescope(-wl)?' >/dev/null") != 0:
            found = list(screens())
            now = {f[0] for f in found}
            if now - names:
                settle()  # something was plugged in
            names = now
            if len(found) > 1:
                for conn, bus, edid in found:
                    st = read(conn, bus, edid)[0]
                    if st == last.get(conn):
                        continue  # act on changes only, so a manual KDE change is never fought
                    last[conn] = st
                    use = st not in ("other-input", "off")
                    enabled = any(open(n).read().strip() == "enabled" for n in glob.glob(f"/sys/class/drm/card*-{conn}/enabled"))
                    others = [c for c, _, _ in found if c != conn and any(open(n).read().strip() == "enabled"
                              for n in glob.glob(f"/sys/class/drm/card*-{c}/enabled"))]
                    if use != enabled and (use or others):  # never switch off the last lit screen
                        print(f"{conn}: {st} -> {'enable' if use else 'disable'}", flush=True)
                        _kwin_enable(conn, use)
        time.sleep(5)


def main(argv):
    cmd, want = (argv[1] if len(argv) > 1 else "list"), argv[2:]
    take_input = "--input" in want
    want = [w for w in want if w != "--input"]
    found = [s for s in screens() if not want or s[0] in want]
    if cmd == "list":
        for conn, bus, edid in found:
            st, power, src = read(conn, bus, edid)
            print(json.dumps({"connector": conn, "state": st, "ddc": bus is not None,
                              "input": INPUTS.get(src, src), "power": power,
                              "name": edid_name(edid)}))
        return 0
    if cmd == "state":
        if not found:
            print("disconnected"); return 0
        st = read(*found[0])[0]
        print(st)
        return 1 if st == "other-input" else 0
    if cmd == "wake":
        for s in found:
            print(s[0], wake(*s, take_input=take_input))
        return 0
    if cmd == "settle":
        settle(); return 0
    if cmd == "watch":
        watch()
    if cmd == "lg-pair":  # egpu-screen lg-pair 192.168.0.240 - accept the prompt on the TV
        print(json.dumps({k: v for k, v in lg_pair(want[0]).items() if k != "key"}, indent=1)); return 0
    if cmd == "lg-state":
        print(lg_read(lg_conf())); return 0
    if cmd == "selftest":  # the input rule without hardware: (connector, power, input) -> state
        global getvcp, _store
        real = getvcp, _store
        _store = lambda update=None: {}
        for conn, power, src, want in [("HDMI-A-1", 1, 0x0F, "other-input"), ("HDMI-A-1", 1, 0x11, "in-use"),
                                       ("DP-7", 1, 0x12, "other-input"), ("DP-7", 1, 0x10, "in-use"),
                                       ("DP-7", 1, 0x1B, "in-use"), ("DP-7", 4, 0x10, "standby"),
                                       ("HDMI-A-1", None, None, "unknown")]:
            getvcp = lambda n, c, p=power, i=src: p if c == 0xD6 else i
            got = read(conn, 0, b"")[0]
            assert got == want, (conn, power, src, got, want)
        assert read("HDMI-A-1", None, b"")[0] == "unknown"
        getvcp, _store = real
        print("ok"); return 0
    print(__doc__); return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
