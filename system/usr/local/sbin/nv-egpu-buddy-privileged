#!/usr/bin/env bash
# Root-owned privileged boundary for the runtime eGPU scripts.
# Only fixed, safety-gated actions are accepted. Never source user-owned files.
set -euo pipefail

PATH=/usr/sbin:/usr/bin:/sbin:/bin
detect_nvidia_gpu_bdf() {
  local dev vendor class
  for dev in /sys/bus/pci/devices/*; do
    [ -r "$dev/vendor" ] || continue
    vendor=$(cat "$dev/vendor" 2>/dev/null || true)
    [ "$vendor" = "0x10de" ] || continue
    class=$(cat "$dev/class" 2>/dev/null || true)
    case "$class" in
      0x030000|0x030200) basename "$dev" ;;
    esac
  done | sort -V | head -n 1
}

GPU=${EGPU_GPU_BDF:-${EGPU_PCI_BDF:-$(detect_nvidia_gpu_bdf)}}
[ -n "$GPU" ] || GPU=0000:62:00.0
AUD=${EGPU_AUDIO_BDF:-${GPU%.*}.1}
GDEV=/sys/bus/pci/devices/$GPU
PCI_DEVICES=/sys/bus/pci/devices
REMOVAL_PROOF=/etc/nv-egpu-buddy/surprise-removal-safe

die() {
  printf 'egpu-privileged: %s\n' "$1" >&2
  exit "${2:-1}"
}

# THE RULE: never operate on hardware that is not an eGPU. Deliberately VENDOR-NEUTRAL
# — an AMD or Intel eGPU must be as welcome here as an NVIDIA one; the per-vendor
# driver checks live in the actions that actually need them. This is the same
# definition egpu-detect uses: a display-class PCI device that does not drive the
# built-in panel. Anything else sitting at this address — a dock, a USB-C display
# controller, a drive — belongs to someone else and nothing here may touch it.
# An address with nothing at it is fine: that is an eGPU that has not enumerated
# yet, and waiting or rescanning for it touches nobody else's device.
_is_display_class() { case "$(cat "$1/class" 2>/dev/null)" in 0x0300*|0x0302*|0x0380*) return 0 ;; esac; return 1; }
_internal_gpu_bdf() {
  local c dev
  for c in /sys/class/drm/card*-eDP-*; do
    [ -e "$c" ] || continue
    dev=$(readlink -f "${c%-eDP-*}/device" 2>/dev/null) && { basename "$dev"; return 0; }
  done
  return 1
}
if [ -e "$GDEV" ]; then
  _is_display_class "$GDEV" ||
    die "$GPU is not a GPU (PCI class $(cat "$GDEV/class" 2>/dev/null)); refusing to touch it" 2
  [ "$GPU" != "$(_internal_gpu_bdf || true)" ] ||
    die "$GPU is the built-in GPU, not an eGPU; refusing to touch it" 2
fi

cfg0() {
  xxd -l4 "$1/config" 2>/dev/null | awk '{print $2$3}'
}

device_state() {
  local dev=$1 width dword
  [ -e "$dev" ] || { printf 'ABSENT\n'; return; }
  width=$(cat "$dev/current_link_width" 2>/dev/null || true)
  [ "$width" = "63" ] && { printf 'ZOMBIE\n'; return; }
  dword=$(cfg0 "$dev" || true)
  if [ "$dword" = "ffffffff" ] || [ -z "$dword" ]; then
    printf 'ZOMBIE\n'
  else
    printf 'ALIVE\n'
  fi
}

gpu_state() {
  device_state "$GDEV"
}

require_gpu_alive() {
  local state
  state=$(gpu_state)
  [ "$state" = "ALIVE" ] || die "GPU is $state; refusing $1" 2
}

require_clean_subtree() {
  local dev state
  for dev in "$PCI_DEVICES"/0000:*; do
    [ -e "$dev" ] || continue
    case "$(cat "$dev/vendor" 2>/dev/null || true)" in
      0x10de|0x8086) ;;
      *) continue ;;
    esac
    state=$(device_state "$dev")
    [ "$state" != "ZOMBIE" ] ||
      die "unreadable device ${dev##*/}; refusing rescan" 2
  done
}

# "Surprise removal is survivable" = the installed modules ARE this project's patched build. It is read from the modules
# themselves (strings only the patches add; the stock 610.57.04 package has neither), not from a flag file: until 0.7.22 the
# proof was /etc/nv-egpu-buddy/surprise-removal-safe, a file that only ever existed on the development machine, so on every
# other machine the display modules were refused and the eGPU never got a display (found on a real SteamOS device).
# A flag file would also stay "yes" after a distro update put the stock driver back. "no" in the file still forces a refusal.
# ponytail: nvidia-drm (patches 165/166) adds no string of its own; it is built in the same package as the two checked here.
_mod_has() { local f c; f=$(modinfo -n "$1" 2>/dev/null) || return 1
  case "$f" in *.zst) c="zstd -dcq" ;; *.xz) c="xz -dcq" ;; *.gz) c="gzip -dcq" ;; *) c=cat ;; esac
  # count, do not -q: an early exit would SIGPIPE the decompressor, and under pipefail that reads as "not found"
  [ "$($c "$f" 2>/dev/null | grep -acF -- "$2" || true)" -gt 0 ]; }
removal_proven() {
  grep -qx 'no' "$REMOVAL_PROOF" 2>/dev/null && return 1
  _mod_has nvidia 'External GPU disconnected.' && _mod_has nvidia_modeset 'Cleaning up stale device from previous surprise removal'
}
require_removal_proof() {
  removal_proven || die "the installed NVIDIA modules are not the patched hot-unplug build; refusing the display-driver load" 2
}

require_supported_driver_stack() {
  local version license
  version=$(modinfo -F version nvidia 2>/dev/null | head -1 || true)
  license=$(modinfo -F license nvidia 2>/dev/null | head -1 || true)
  [ -n "$version" ] && [ -n "$license" ] ||
    die "NVIDIA kernel module is not identifiable; refusing eGPU attach" 2
  # 2026-08-19 Blackwell pivot: the RTX 5060 Ti (GB206) ONLY works on the OPEN
  # modules (proprietary refuses to bind: "requires use of the NVIDIA open
  # kernel modules"). The old block on Dual MIT/GPL was an Ampere/3080-era rule
  # (open+GSP caused a data-fabric sync flood on that card) and is now inverted.
  # Guard on VERSION instead: 580 GSP hard-reset this AMD platform every ~35min;
  # 610.57.04 fixed it. Refuse anything older than 590.
  case "$license" in
    *"Dual MIT/GPL"*)
      case "${version%%.*}" in
        ''|*[!0-9]*)
          die "NVIDIA open module version '$version' unparseable; refusing eGPU attach" 2
          ;;
        *)
          [ "${version%%.*}" -ge 590 ] ||
            die "NVIDIA open module $version is too old for this eGPU (needs >=590; 580 GSP hard-resets this AMD platform)" 2
          ;;
      esac
      ;;
  esac
}

require_compute_only_driver_state() {
  if ! removal_proven && [ -d /sys/module/nvidia_drm ]; then
    die "NVIDIA DRM is loaded without removal proof; refusing compute attach" 2
  fi
}

require_safe_display_handoff() {
  local card enabled internal_enabled=no
  for enabled in /sys/class/drm/card*-eDP-*/enabled; do
    [ -e "$enabled" ] || continue
    [ "$(cat "$enabled" 2>/dev/null || true)" != "enabled" ] || internal_enabled=yes
  done

  # Wayland/atomic KMS can leave the legacy 'enabled' sysfs attribute stale.
  # Connector presence alone is not proof of a usable panel: after a failed
  # eGPU detach we observed eDP-1 status=connected while every CRTC was
  # active=0 and the screen was black. Accept only a legacy enabled flag or an
  # atomic state where an eDP connector is actually attached to a CRTC.
  if [ "$internal_enabled" != "yes" ]; then
    for state in /sys/kernel/debug/dri/[0-9]*/state /sys/kernel/debug/dri/0000:*/state; do
      [ -r "$state" ] || continue
      awk '
        /^connector\[[0-9]+\]: eDP-/ { in_edp = 1; next }
        /^connector\[/ { in_edp = 0 }
        in_edp && /^[[:space:]]*crtc=crtc-/ { found = 1 }
        END { exit(found ? 0 : 1) }
      ' "$state" && { internal_enabled=yes; break; }
    done
  fi
  [ "$internal_enabled" = "yes" ] ||
    die "internal panel is not actively lit; refusing GPU removal" 2

  for card in "$GDEV"/drm/card*; do
    [ -e "$card" ] || continue
    for enabled in "$card"/card*-*/enabled; do
      [ -e "$enabled" ] || continue
      [ "$(cat "$enabled" 2>/dev/null || true)" = "enabled" ] || continue
      # The legacy 'enabled' attribute goes stale after KWin moves off the eGPU
      # (detach mode). Only refuse if the connector is ACTUALLY attached to a CRTC
      # in the atomic state — otherwise nothing is being driven and removal is safe.
      _rsdh_conn=$(basename "$(dirname "$enabled")"); _rsdh_conn=${_rsdh_conn#card*-}
      _rsdh_active=0
      for state in /sys/kernel/debug/dri/[0-9]*/state /sys/kernel/debug/dri/0000:*/state; do
        [ -r "$state" ] || continue
        awk -v c="$_rsdh_conn" '
          $0 ~ ("^connector\\[[0-9]+\\]: " c "$") { in_c = 1; next }
          /^connector\[/ { in_c = 0 }
          in_c && /^[[:space:]]*crtc=crtc-/ { found = 1 }
          END { exit(found ? 0 : 1) }
        ' "$state" && { _rsdh_active=1; break; }
      done
      [ "$_rsdh_active" = 1 ] &&
        die "an eGPU display output ($_rsdh_conn) is driving a CRTC; refusing GPU removal" 2
    done
  done
}

require_no_external_link() {
  local dev name
  [ "$(gpu_state)" = "ABSENT" ] || die "GPU is present; refusing host-link recovery" 2

  for dev in "$PCI_DEVICES"/0000:*; do
    [ -e "$dev" ] || continue
    case "$(cat "$dev/vendor" 2>/dev/null || true)" in
      0x10de|0x8086) die "eGPU PCIe subtree still exists at ${dev##*/}; refusing host-link recovery" 2 ;;
    esac
  done

  for dev in /sys/bus/thunderbolt/devices/*; do
    [ -e "$dev" ] || continue
    name=${dev##*/}
    case "$name" in
      domain*|[0-9]*-0) ;;
      *) die "external Thunderbolt device exists; refusing host-link recovery" 2 ;;
    esac
  done

  for dev in /sys/class/typec/*-partner; do
    [ -e "$dev" ] || continue
    die "Type-C partner exists; refusing host-link recovery" 2
  done
}

bridge_has_children() {
  local bridge=$1 bridge_real child child_real
  bridge_real=$(readlink -f "$bridge" 2>/dev/null || true)
  [ -n "$bridge_real" ] || return 1
  for child in "$PCI_DEVICES"/*; do
    [ -e "$child" ] || continue
    child_real=$(readlink -f "$child" 2>/dev/null || true)
    case "$child_real" in
      "$bridge_real"/*) return 0 ;;
    esac
  done
  return 1
}

require_empty_sibling_bridge() {
  local bdf=$1 dev class gpu_real gpu_bridge switch_dir dev_real
  dev=$PCI_DEVICES/$bdf
  [ -e "$dev" ] || die "sibling $bdf is absent" 2
  [ "$(device_state "$dev")" = "ALIVE" ] ||
    die "sibling $bdf is absent or unreadable" 2
  class=$(cat "$dev/class" 2>/dev/null || true)
  [ "$class" = "0x060400" ] ||
    die "sibling $bdf is not a PCI bridge" 2
  gpu_real=$(readlink -f "$GDEV" 2>/dev/null || true)
  dev_real=$(readlink -f "$dev" 2>/dev/null || true)
  [ -n "$gpu_real" ] && [ -n "$dev_real" ] ||
    die "cannot resolve GPU/sibling sysfs paths" 2
  gpu_bridge=$(dirname "$gpu_real")
  switch_dir=$(dirname "$gpu_bridge")
  case "$dev_real" in
    "$switch_dir"/*) ;;
    *) die "sibling $bdf is not on the active eGPU switch" 2 ;;
  esac
  [ "$dev_real" != "$gpu_bridge" ] ||
    die "refusing to remove the active GPU downstream bridge" 2
  ! bridge_has_children "$dev" ||
    die "sibling $bdf has child devices; refusing remove" 2
}

[ "$(id -u)" -eq 0 ] || die "must run as root"
[ "$#" -ge 1 ] || die "missing action"

action=$1
shift

case "$action" in
  status)
    [ "$#" -eq 0 ] || die "status takes no arguments"
    gpu_state
    ;;
  mask-surprise-down)
    # Make a cable pull survivable. Root ports WITHOUT Downstream Port Containment answer a lost
    # link with an uncorrectable error, and this platform answers THAT with a data-fabric sync
    # flood: an instant hard reset, no shutdown, no log.
    #
    # Masking only the root port was not enough. The hardware accepts only some mask bits (seen:
    # we write ffffffff, the port keeps 035dd010) and leaves errors in UESvrt still FATAL — and the
    # switch ports BETWEEN the root port and the GPU were never touched at all, so an error raised
    # there reached the fabric unmasked. A 3080 attach reset the machine with the root port
    # "protected". Every bridge in the path is masked now, and the GPU itself.
    [ "$#" -eq 0 ] || die "mask-surprise-down takes no arguments"
    _msd_real=$(readlink -f "$GDEV" 2>/dev/null) || die "eGPU is not present" 2
    # every PCI function from the GPU up to (and including) the root port
    _msd_chain=$(printf '%s\n' "$_msd_real" | grep -oE '[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-7]')
    [ -n "$_msd_chain" ] || die "could not walk the eGPU's PCI path" 2
    for _msd_d in $_msd_chain; do
      _msd_off=0x100; _msd_aer=""; _msd_dpc=0
      for _ in $(seq 1 48); do
        _msd_v=$(setpci -s "$_msd_d" "$_msd_off".l 2>/dev/null) || break
        _msd_id=$(( 0x$_msd_v & 0xffff )); _msd_nxt=$(( (0x$_msd_v >> 20) & 0xffc ))
        [ "$_msd_id" -eq 29 ] && _msd_dpc=1
        [ "$_msd_id" -eq 1 ] && _msd_aer=$_msd_off
        [ "$_msd_nxt" -eq 0 ] && break; _msd_off=$(printf 0x%x "$_msd_nxt")
      done
      if [ "$_msd_dpc" = 1 ]; then
        printf '%s: has DPC, left alone\n' "$_msd_d"; continue
      fi
      [ -n "$_msd_aer" ] || { printf '%s: no AER capability\n' "$_msd_d"; continue; }
      setpci -s "$_msd_d" "$(printf 0x%x $((_msd_aer+0x08)))".l=ffffffff 2>/dev/null
      setpci -s "$_msd_d" "$(printf 0x%x $((_msd_aer+0x0c)))".l=00000000 2>/dev/null
      printf '%s: masked (UEMsk=%s UESvrt=%s)\n' "$_msd_d" \
        "$(setpci -s "$_msd_d" "$(printf 0x%x $((_msd_aer+0x08)))".l 2>/dev/null)" \
        "$(setpci -s "$_msd_d" "$(printf 0x%x $((_msd_aer+0x0c)))".l 2>/dev/null)"
    done
    ;;
  reenumerate-tunnel)
    # Re-enumerate the eGPU's whole Thunderbolt subtree so the kernel sizes the bridge windows
    # again, the way it does for a device that arrives AFTER boot. This is the difference between
    # a 16GiB BAR1 and 256MiB: at boot the device is already there and the bridges keep the small
    # windows firmware assigned, so a resize is refused with ENOSPC; a hot-plugged device gets the
    # reserve from pci=hpmemprefsize instead. Removing only the GPU is not enough — its parent
    # bridge keeps its window — so the bridge below the root port goes, and comes back with it.
    [ "$#" -eq 0 ] || die "reenumerate-tunnel takes no arguments"
    [ ! -L "$GDEV/driver" ] || die "GPU has a bound driver; refusing re-enumeration" 2
    _rt_real=$(readlink -f "$GDEV" 2>/dev/null) || die "GPU is not present" 2
    # path looks like /sys/devices/pci0000:00/0000:00:04.1/0000:63:00.0/0000:64:00.0/0000:65:00.0
    _rt_bridge=$(printf '%s\n' "$_rt_real" | awk -F/ '{for(i=1;i<=NF;i++) if($i ~ /^pci[0-9a-f]{4}:[0-9a-f]{2}$/) {print $(i+2); exit}}')
    [ -n "$_rt_bridge" ] && [ -d "/sys/bus/pci/devices/$_rt_bridge" ] ||
      die "could not identify the eGPU's upstream bridge" 2
    # NOTHING but the eGPU may live under it: never yank a dock, a drive or someone's display controller
    # scan the REAL device tree: /sys/bus/pci/devices/<bdf> is a symlink and find does not follow it
    _rt_root=$(readlink -f "/sys/bus/pci/devices/$_rt_bridge")
    # real PCI functions only: the tree also holds bus directories (0000:64) and port services
    # (0000:64:00.0:pcie210), which have no class and would otherwise read as "not ours"
    for _rt_dev in $(find "$_rt_root" -maxdepth 4 -name '0000:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f].[0-7]' -printf '%f\n' 2>/dev/null | sort -u); do
      _rt_c=$(cat "/sys/bus/pci/devices/$_rt_dev/class" 2>/dev/null)
      [ -n "$_rt_c" ] || continue
      case "$_rt_c" in 0x0604*|0x0600*) continue ;; esac          # bridges are part of the tunnel
      [ "$(cat "/sys/bus/pci/devices/$_rt_dev/vendor" 2>/dev/null)" = "0x10de" ] ||
        die "$_rt_dev (class $_rt_c) is behind $_rt_bridge and is not part of the eGPU; refusing re-enumeration" 2
    done
    # Removing the bridge fires a PCI remove event for the GPU, and the udev rule reads that as a
    # cable pull: the surprise-removal recovery then tore the eGPU session down ~90s into boot, with
    # the card still plugged in. Mark the removal as ours for the duration.
    mkdir -p /run/nvegpu 2>/dev/null
    date +%s > /run/nvegpu/deliberate-removal
    printf 'removing %s to re-enumerate the eGPU tunnel\n' "$_rt_bridge"
    echo 1 > "/sys/bus/pci/devices/$_rt_bridge/remove"
    sleep 2
    echo 1 > /sys/bus/pci/rescan
    # give the kernel time to finish assigning the bridge windows before anyone asks for a big BAR:
    # asking 3 seconds after the rescan was refused, while the same request succeeded later
    for _rt_i in $(seq 1 20); do [ -e "$GDEV" ] && break; sleep 1; done
    sleep 5
    rm -f /run/nvegpu/deliberate-removal
    ;;
  rescan)
    [ "$#" -eq 0 ] || die "rescan takes no arguments"
    require_supported_driver_stack
    [ "$(gpu_state)" = "ABSENT" ] || die "GPU is already present; refusing rescan" 2
    require_clean_subtree
    echo 1 > /sys/bus/pci/rescan
    ;;
  remove-sibling)
    [ "$#" -eq 1 ] || die "remove-sibling requires one BDF"
    require_empty_sibling_bridge "$1"
    dev=$PCI_DEVICES/$1
    echo 1 > "$dev/remove"
    ;;
  unbind-nvidia)
    [ "$#" -eq 0 ] || die "unbind-nvidia takes no arguments"
    require_gpu_alive "NVIDIA unbind"
    driver=$(basename "$(readlink -f "$GDEV/driver" 2>/dev/null)" 2>/dev/null || true)
    [ "$driver" = "nvidia" ] ||
      die "GPU is not bound to NVIDIA" 2
    ! compgen -G "$GDEV/drm/card*" >/dev/null ||
      die "NVIDIA DRM card exists; refusing unbind" 2
    echo "$GPU" > /sys/bus/pci/drivers/nvidia/unbind
    ;;
  resize)
    [ "$#" -eq 1 ] || die "resize requires one size code"
    # Ask the CARD what it supports instead of listing sizes that suit one GPU. resource1_resize is
    # a bitmask: bit N set means 2^N MB is available. A 16GB BAR is right for a 16GB card and simply
    # does not exist on a 10GB one, so a hardcoded list would leave other cards at the stock size.
    _rz_mask=$(cat "$GDEV/resource1_resize" 2>/dev/null)
    [ -n "$_rz_mask" ] || die "BAR1 resize control is absent" 2
    case "$1" in ''|*[!0-9]*) die "resize takes a size code" 2 ;; esac
    [ "$1" -le 31 ] || die "resize code $1 is out of range" 2
    [ $(( (0x$_rz_mask >> $1) & 1 )) -eq 1 ] ||
      die "this GPU does not support BAR1 size code $1 (it advertises mask 0x$_rz_mask)" 2
    require_gpu_alive "BAR1 resize"
    [ ! -L "$GDEV/driver" ] || die "GPU has a bound driver; refusing resize" 2
    [ -e "$GDEV/resource1_resize" ] || die "BAR1 resize control is absent" 2
    echo "$1" > "$GDEV/resource1_resize"
    ;;
  iommu-passthrough)
    # Realise the cmdline's iommu=pt intent for the eGPU. The kernel marks anything behind Thunderbolt
    # as untrusted/removable and forces its IOMMU group into a translated DMA domain for DMA-attack
    # protection, overriding iommu=pt. That makes every GPU DMA pay page-table translation + IOTLB
    # misses. Flipping the group to 'identity' removes that. Only possible while EVERY device in the
    # group is driver-unbound, so this runs in the same driverless window as the BAR1 resize.
    [ "$#" -eq 0 ] || die "iommu-passthrough takes no arguments"
    require_gpu_alive "IOMMU passthrough"
    [ ! -L "$GDEV/driver" ] || die "GPU has a bound driver; refusing IOMMU change" 2
    grp=$(basename "$(readlink -f "$GDEV/iommu_group" 2>/dev/null)" 2>/dev/null)
    [ -n "$grp" ] && [ -w "/sys/kernel/iommu_groups/$grp/type" ] || die "IOMMU group type not writable" 2
    for dev in /sys/kernel/iommu_groups/"$grp"/devices/*; do
      b=$(basename "$dev")
      if [ -L "/sys/bus/pci/devices/$b/driver" ]; then
        drv=$(basename "$(readlink -f "/sys/bus/pci/devices/$b/driver")")
        [ "$drv" = "nvidia" ] && die "nvidia still bound to $b" 2
        printf '%s' "$b" > "/sys/bus/pci/devices/$b/driver/unbind" 2>/dev/null || true
      fi
    done
    cur=$(cat "/sys/kernel/iommu_groups/$grp/type" 2>/dev/null)
    if [ "$cur" != "identity" ]; then
      printf 'identity' > "/sys/kernel/iommu_groups/$grp/type" || die "IOMMU group $grp refused identity" 1
    fi
    printf 'iommu group %s: %s\n' "$grp" "$(cat "/sys/kernel/iommu_groups/$grp/type")"
    ;;
  bar1)
    [ "$#" -eq 0 ] || die "bar1 takes no arguments"
    require_gpu_alive "BAR1 inspection"
    lspci -vvs "$GPU"
    ;;
  reset-gpu)
    # Function-Level Reset of the GPU while driverless. Clears the host-side
    # first-init residue that makes NVIDIA RmInitAdapter (0x24:0x72:1603) fail on
    # every warm replug after the first since boot. FLR ONLY — never a secondary
    # bus reset (that is the fabric-flood family). Refuses on a bound/zombie GPU.
    [ "$#" -eq 0 ] || die "reset-gpu takes no arguments"
    require_gpu_alive "function-level reset"
    [ ! -L "$GDEV/driver" ] || die "GPU has a bound driver; refusing reset" 2
    [ -e "$GDEV/reset_method" ] || die "reset control is absent" 2
    case " $(cat "$GDEV/reset_method" 2>/dev/null || true) " in
      *" flr "*) ;;
      *) die "FLR is not an available reset method; refusing (no bus-reset fallback)" 2 ;;
    esac
    # Pin to FLR so the kernel can never fall back to a flood-risky bus reset.
    echo flr > "$GDEV/reset_method"
    echo 1 > "$GDEV/reset"
    ;;
  load-nvidia)
    [ "$#" -eq 0 ] || die "load-nvidia takes no arguments"
    require_supported_driver_stack
    require_gpu_alive "NVIDIA probe"
    require_compute_only_driver_state
    modprobe --ignore-install nvidia
    ;;
  bind-nvidia)
    [ "$#" -eq 0 ] || die "bind-nvidia takes no arguments"
    require_supported_driver_stack
    require_gpu_alive "NVIDIA bind"
    require_compute_only_driver_state
    [ ! -L "$GDEV/driver" ] || die "GPU already has a bound driver" 2
    echo "$GPU" > /sys/bus/pci/drivers/nvidia/bind
    ;;
  load-modeset)
    [ "$#" -eq 0 ] || die "load-modeset takes no arguments"
    require_removal_proof
    require_gpu_alive "NVIDIA modeset probe"
    modprobe --ignore-install nvidia_modeset
    ;;
  load-drm)
    [ "$#" -eq 0 ] || die "load-drm takes no arguments"
    require_removal_proof
    require_gpu_alive "NVIDIA DRM probe"
    modprobe --ignore-install nvidia_drm modeset=1 fbdev=1
    ;;
  remove-audio)
    [ "$#" -eq 0 ] || die "remove-audio takes no arguments"
    require_gpu_alive "audio-function removal"
    if [ -e "$PCI_DEVICES/$AUD" ]; then
      # Unbind snd_hda_intel from THIS function first. Removing it while bound blocks
      # in D-state (snd_card teardown inside the PCI-remove path). Unbinding does the
      # teardown separately (~2s) so the subsequent remove is instant. Only this
      # function — the iGPU HDA (c2:00.1/.6) shares the driver.
      if [ -L "$PCI_DEVICES/$AUD/driver" ]; then
        _ra_drv=$(basename "$(readlink -f "$PCI_DEVICES/$AUD/driver")")
        echo "$AUD" > "/sys/bus/pci/drivers/$_ra_drv/unbind" 2>/dev/null || true
        for _ in $(seq 1 10); do [ -L "$PCI_DEVICES/$AUD/driver" ] || break; sleep 0.5; done
      fi
      echo 1 > "$PCI_DEVICES/$AUD/remove"
    fi
    ;;
  remove-gpu)
    [ "$#" -eq 0 ] || die "remove-gpu takes no arguments"
    require_gpu_alive "GPU removal"
    require_safe_display_handoff
    if [ -w "$GDEV/remove" ]; then
      echo 1 > "$GDEV/remove"
    else
      # No 'remove' attribute on the endpoint (Blackwell eGPU exposes only reset/rescan).
      # Remove the parent hotplug bridge instead: that tears down the whole subtree.
      # Walk up to the first ancestor exposing a writable 'remove'. Stop before the
      # host USB4 root port (1022:150a) so we only tear down the eGPU subtree.
      _rg_node=$(readlink -f "$GDEV" 2>/dev/null)
      _rg_target=""
      while :; do
        _rg_node=$(dirname "$_rg_node")
        case "$_rg_node" in */devices/pci*) ;; *) break ;; esac
        _rg_bdf=$(basename "$_rg_node")
        case "$_rg_bdf" in 0000:*) ;; *) break ;; esac
        # never remove the host's own USB4 root port
        if [ "$(cat "$_rg_node/vendor" 2>/dev/null)" = "0x1022" ] &&
           [ "$(cat "$_rg_node/device" 2>/dev/null)" = "0x150a" ]; then
          break
        fi
        if [ -w "$_rg_node/remove" ]; then _rg_target=$_rg_bdf; break; fi
      done
      if [ -n "$_rg_target" ]; then
        echo "egpu-privileged: endpoint has no remove node; removing ancestor $_rg_target (tears down the eGPU subtree)" >&2
        echo 1 > "$PCI_DEVICES/$_rg_target/remove"
      else
        die "no removable node for $GDEV (no ancestor below the host root port has 'remove')" 2
      fi
    fi
    ;;
  unload-nvidia)
    [ "$#" -eq 0 ] || die "unload-nvidia takes no arguments"
    [ "$(gpu_state)" = "ABSENT" ] || die "GPU is still present; refusing module unload" 2
    modprobe -r nvidia_drm nvidia_modeset nvidia_uvm nvidia_peermem nvidia
    ;;
  reset-ucsi)
    [ "$#" -eq 0 ] || die "reset-ucsi takes no arguments"
    require_no_external_link
    [ -e /sys/bus/platform/drivers/ucsi_acpi/USBC000:00 ] ||
      die "UCSI ACPI device is not bound" 2
    echo USBC000:00 > /sys/bus/platform/drivers/ucsi_acpi/unbind
    sleep 2
    echo USBC000:00 > /sys/bus/platform/drivers/ucsi_acpi/bind
    ;;
  set-cpu-performance)
    [ "$#" -eq 0 ] || die "set-cpu-performance takes no arguments"
    for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
      [ -e "$f" ] && echo performance > "$f" || true
    done
    for f in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do
      [ -e "$f" ] && echo performance > "$f" || true
    done
    ;;
  set-cpu-powersave)
    [ "$#" -eq 0 ] || die "set-cpu-powersave takes no arguments"
    for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
      [ -e "$f" ] && echo powersave > "$f" || true
    done
    for f in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do
      [ -e "$f" ] && echo balance_performance > "$f" || true
    done
    ;;
  set-session-plasma)
    [ "$#" -eq 0 ] || die "set-session-plasma takes no arguments"
    /usr/local/sbin/egpu-dm-session pin plasma
    ;;
  set-session-gamescope)
    [ "$#" -eq 0 ] || die "set-session-gamescope takes no arguments"
    /usr/local/sbin/egpu-dm-session pin gamescope
    ;;
  set-session-bigpicture)
    [ "$#" -eq 0 ] || die "set-session-bigpicture takes no arguments"
    /usr/local/sbin/egpu-dm-session pin bigpicture
    ;;
  panel-off|panel-on)
    # handheld panel while an eGPU display is active (egpu-panel does the DRM/backlight work; root only)
    [ "$#" -eq 0 ] || die "$action takes no arguments"
    /usr/local/sbin/egpu-panel "${action#panel-}"
    ;;
  vt-bounce)
    # gamescope started paused after a relogin (libseat seat inactive: no "Session resumed", CRTC never enabled).
    # A VT round-trip makes logind re-activate the session -> "Enabling seat" -> gamescope modesets.
    [ "$#" -eq 0 ] || die "vt-bounce takes no arguments"
    cur=$(cat /sys/class/tty/tty0/active 2>/dev/null); cur=${cur#tty}
    chvt 2; sleep 1; chvt "${cur:-1}"
    ;;
  emergency-console)
    # eGPU yank lifeboat: switch the foreground VT to tty3 (fbcon deferred-takeover fires on
    # first visible output -> console appears on the AMD/eDP panel, untouched by the dead eGPU).
    [ "$#" -eq 0 ] || die "emergency-console takes no arguments"
    systemctl start getty@tty3.service 2>/dev/null || true
    chvt 3
    ;;
  restart-display-manager)
    [ "$#" -eq 0 ] || die "restart-display-manager takes no arguments"
    dm=$(systemctl show -p Id --value display-manager.service 2>/dev/null || true)
    case "$dm" in
      plasmalogin.service|sddm.service) systemctl restart "$dm" ;;
      *) die "unsupported display manager '$dm'" 2 ;;
    esac
    ;;
  set-gpu-power-limit)
    [ "$#" -eq 1 ] || die "set-gpu-power-limit requires one argument (Watts)"
    limit=$1
    if [[ ! "$limit" =~ ^[0-9]+$ ]] || [ "$limit" -lt 100 ] || [ "$limit" -gt 320 ]; then
      die "invalid power limit: $limit (must be between 100 and 320)" 2
    fi
    require_gpu_alive "set-gpu-power-limit"
    nvidia-smi -pl "$limit"
    ;;
  set-gpu-graphics-clock)
    [ "$#" -eq 1 ] || die "set-gpu-graphics-clock requires one argument (MHz)"
    clock=$1
    if [[ ! "$clock" =~ ^[0-9]+$ ]] || [ "$clock" -lt 210 ] || [ "$clock" -gt 2100 ]; then
      die "invalid graphics clock: $clock (must be between 210 and 2100)" 2
    fi
    require_gpu_alive "set-gpu-graphics-clock"
    nvidia-smi -lgc "210,$clock"
    ;;
  set-gpu-core-offset)
    [ "$#" -eq 1 ] || die "set-gpu-core-offset requires one argument (MHz)"
    offset=$1
    if [[ ! "$offset" =~ ^-?[0-9]+$ ]] || [ "$offset" -lt -500 ] || [ "$offset" -gt 500 ]; then
      die "invalid core offset: $offset (must be between -500 and 500)" 2
    fi
    require_gpu_alive "set-gpu-core-offset"
    if [ -x /usr/local/bin/nv-egpu-offset-helper ]; then
      /usr/local/bin/nv-egpu-offset-helper "$offset"
    else
      die "offset helper binary is missing" 3
    fi
    ;;
  reset-gpu-clocks)
    [ "$#" -eq 0 ] || die "reset-gpu-clocks takes no arguments"
    require_gpu_alive "reset-gpu-clocks"
    nvidia-smi -rgc
    if [ -x /usr/local/bin/nv-egpu-offset-helper ]; then
      /usr/local/bin/nv-egpu-offset-helper 0
    fi
    ;;
  dpc-off)
    # Strix Halo USB4 second-port eGPU PCIe-tunnel fix. Clear PCIe DPC trigger
    # on the AMD USB4 root-port bridges [1022:150a] so the tunnel-formation
    # surprise-down error no longer contains the link. Device-gated -> no-op on
    # other APUs. If the GPU is absent, rebuild any contained tunnel by
    # re-authorizing the external TB device (only when absent, so an active
    # display tunnel is never disturbed). See docs / second-port DPC notes.
    [ "$#" -eq 0 ] || die "dpc-off takes no arguments"
    command -v setpci >/dev/null 2>&1 || die "setpci missing" 2
    for P in $(lspci -D -d 1022:150a -n 2>/dev/null | awk '{print $1}'); do
      off=0x100
      for _ in $(seq 1 48); do
        v=$(setpci -s "$P" "$off".l 2>/dev/null) || break
        id=$(( 0x$v & 0xffff )); nxt=$(( (0x$v >> 20) & 0xffc ))
        if [ "$id" -eq 29 ]; then
          dctl=$(printf 0x%x $(( off + 0x06 )))
          c=$(setpci -s "$P" "$dctl".w)
          setpci -s "$P" "$dctl".w=$(printf %04x $(( 0x$c & ~0x3 )))
          echo "dpc-off: $P DPC trigger $c -> $(setpci -s "$P" "$dctl".w)"
          break
        fi
        [ "$nxt" -eq 0 ] && break
        off=$(printf 0x%x "$nxt")
      done
    done
    if [ "$(gpu_state)" = "ABSENT" ]; then
      for tb in /sys/bus/thunderbolt/devices/*-*; do
        [ -e "$tb/authorized" ] && [ -e "$tb/device_name" ] || continue
        [ "$(cat "$tb/authorized" 2>/dev/null)" = "1" ] || continue
        echo 0 > "$tb/authorized" 2>/dev/null || true
        echo 1 > "$tb/authorized" 2>/dev/null || true
        echo "dpc-off: re-authorized $(basename "$tb") to rebuild PCIe tunnel"
      done
      sleep 2
      # enumeration is left to the caller's guarded rescan (anti-flood checks).
    fi
    ;;
  dpc-on)
    # Re-ARM PCIe DPC trigger on the AMD USB4 root-port bridges [1022:150a] AFTER
    # the eGPU tunnel is established. This restores Downstream Port Containment so
    # a SURPRISE cable yank is contained at the PCIe port (Surprise-Down fatal
    # error -> link contained + subtree removed) instead of hanging the bus.
    # Set trigger-enable bits[1:0] = 01b (enabled on ERR_FATAL). Device-gated.
    [ "$#" -eq 0 ] || die "dpc-on takes no arguments"
    command -v setpci >/dev/null 2>&1 || die "setpci missing" 2
    for P in $(lspci -D -d 1022:150a -n 2>/dev/null | awk '{print $1}'); do
      off=0x100
      for _ in $(seq 1 48); do
        v=$(setpci -s "$P" "$off".l 2>/dev/null) || break
        id=$(( 0x$v & 0xffff )); nxt=$(( (0x$v >> 20) & 0xffc ))
        if [ "$id" -eq 29 ]; then
          dctl=$(printf 0x%x $(( off + 0x06 )))
          c=$(setpci -s "$P" "$dctl".w)
          setpci -s "$P" "$dctl".w=$(printf %04x $(( (0x$c & ~0x3) | 0x1 )))
          echo "dpc-on: $P DPC trigger $c -> $(setpci -s "$P" "$dctl".w)"
          break
        fi
        [ "$nxt" -eq 0 ] && break
        off=$(printf 0x%x "$nxt")
      done
    done
    ;;
  *)
    die "unknown action: $action"
    ;;
esac
