# NV-EGPU-Buddy: auto-mount the eGPU when its Thunderbolt dock links after boot
# (the dock does not establish the TB link at cold boot; only on a physical replug).
ACTION=="add", SUBSYSTEM=="thunderbolt", ENV{DEVTYPE}=="thunderbolt_device", RUN+="/usr/bin/systemd-run --no-block /usr/local/sbin/egpu-hotplug-mount.sh"
