# Monitor woke / connector changed on the NVIDIA eGPU: re-run the mount hook (idempotent: it only
# re-stages the session if KWin still holds an AMD node).
ACTION=="change", SUBSYSTEM=="drm", KERNEL=="card[0-9]*", ENV{HOTPLUG}=="1", ATTRS{vendor}=="0x10de", RUN+="/usr/bin/systemd-run --no-block /usr/local/sbin/egpu-hotplug-mount.sh"
