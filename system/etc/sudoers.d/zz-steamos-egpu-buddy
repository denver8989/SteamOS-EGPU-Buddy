# SteamOS-EGPU-Buddy: the Decky plugin, the desktop app and the Safe Detach tool call these without a password.
# The file name starts with zz- ON PURPOSE: sudo applies the LAST matching rule, and /etc/sudoers.d is read in lexical
# order. SteamOS ships /etc/sudoers.d/wheel with "%wheel ALL=(ALL) ALL" and its "deck" user is in wheel, so a file named
# steamos-egpu-buddy lost to it and every password-less call was refused ("a password is required") - the desktop app's
# Safe Detach died at its first step. Sorting last keeps these NOPASSWD rules effective on both distributions.
deck ALL=(root) NOPASSWD: /usr/local/sbin/nv-egpu-buddy-privileged *
deck ALL=(root) NOPASSWD: /usr/local/sbin/egpu-safe-detach, /usr/local/sbin/egpu-safe-detach *
deck ALL=(root) NOPASSWD: /usr/local/sbin/egpu-reattach
deck ALL=(root) NOPASSWD: /usr/local/sbin/egpu-gamemode-switch, /usr/local/sbin/egpu-gamemode-switch --force
deck ALL=(root) NOPASSWD: /usr/local/sbin/egpu-gamemode-detach
deck ALL=(root) NOPASSWD: /usr/local/sbin/egpu-rearm
