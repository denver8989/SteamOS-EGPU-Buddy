[Unit]
Description=SteamOS EGPU Buddy: take the eGPU down cleanly at power-off / reboot
# Stop order is the reverse of start order: being "After" these means our ExecStop runs once they have stopped —
# the session (gamescope / Steam / PipeWire), Decky (it polls nvidia-smi) and bolt are gone, the USB4 tunnel is still up.
After=display-manager.service plasmalogin.service systemd-user-sessions.service user.slice plugin_loader.service bolt.service egpu-mount.service egpu-boot-enumerate.service
ConditionPathExists=/usr/local/sbin/egpu-shutdown-teardown

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/usr/local/sbin/egpu-shutdown-teardown
# backstop: shutdown never waits on the teardown for longer than this
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
