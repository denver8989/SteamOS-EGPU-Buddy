[Unit]
Description=Pick boot session: eGPU-rendered Desktop if dGPU docked, else Game Mode
Documentation=NV-EGPU-Buddy conditional-session (user-authorized 2026-06-18)
After=systemd-udevd.service local-fs.target
Before=plasmalogin.service display-manager.service
ConditionPathExists=/usr/local/sbin/egpu-conditional-session

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/egpu-conditional-session

[Install]
WantedBy=multi-user.target
