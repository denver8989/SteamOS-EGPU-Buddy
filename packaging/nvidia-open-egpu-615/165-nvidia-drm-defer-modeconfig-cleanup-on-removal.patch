diff --git a/kernel-open/nvidia-drm/nvidia-drm-drv.c b/kernel-open/nvidia-drm/nvidia-drm-drv.c
index 8f5cf4d..ecabf70 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-drv.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-drv.c
@@ -964,7 +964,21 @@ static void nv_drm_dev_unload(struct drm_device *dev)
 
         atomic_set(&nv_dev->enable_event_handling, false);
         drm_kms_helper_poll_fini(dev);
-        drm_mode_config_cleanup(dev);
+
+        if (nv_drm_vblank_module_param) {
+            nv_drm_workthread_shutdown(&nv_dev->vblank_worker);
+        }
+
+        /*
+         * Do NOT tear down the mode configuration here: a compositor may still
+         * hold the connector/CRTC/plane objects and framebuffers.  The DRM
+         * device is already unplugged (ioctls fail with -ENODEV); its clients
+         * release their framebuffers through drm_release(), and the mode
+         * config is cleaned up in nv_drm_dev_release() once the last reference
+         * is dropped.  Tearing it down now leaks the connector and corrupts
+         * fb_list, faulting in drm_framebuffer_cleanup() on the client's close.
+         */
+        WRITE_ONCE(nv_dev->modeConfigCleanupPending, NV_TRUE);
 
         pDevice = READ_ONCE(nv_dev->pDevice);
         WRITE_ONCE(nv_dev->pDevice, NULL);
@@ -2334,6 +2348,15 @@ static void nv_drm_dev_release(struct drm_device *dev)
     }
 
     nv_dev = dev->dev_private;
+
+    /*
+     * Mode-config teardown deferred from nv_drm_dev_unload() (surprise removal):
+     * on kernels with the managed drm_mode_config_init() the DRM core runs
+     * drm_mode_config_cleanup() itself right after this callback (drm_managed_release),
+     * once every client has closed.  Calling it here as well double-puts the
+     * connectors (refcount underflow, ida double-free).  So: nothing to do.
+     */
+
     dev->dev_private = NULL;
 
     if (nv_dev != NULL) {
diff --git a/kernel-open/nvidia-drm/nvidia-drm-priv.h b/kernel-open/nvidia-drm/nvidia-drm-priv.h
index 855d0a2..ecb2417 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-priv.h
+++ b/kernel-open/nvidia-drm/nvidia-drm-priv.h
@@ -185,6 +185,12 @@ struct nv_drm_device {
      */
     NvBool inRemoval;
 
+    /*
+     * Set when the device was unloaded while DRM clients still held objects:
+     * drm_mode_config_cleanup() is deferred to nv_drm_dev_release() (last ref).
+     */
+    NvBool modeConfigCleanupPending;
+
     struct drm_property *nv_out_fence_property;
     struct drm_property *nv_input_colorspace_property;
     struct drm_property *nv_hdcp_level_property;
