+/*
+ * NV-EGPU-Buddy: surprise removal leaks the kapi popen on purpose (closing it would touch the
+ * missing hardware). Detach it from its NvKmsKapiDevice and wait for in-flight event work, so
+ * nvkms_kapi_event_kthread_q_callback() can never run against the freed device (NULL deref in
+ * nvKmsKapiHandleEventQueueChange under gamescope, 2026-09-11).
+ */
+void nvkms_detach_kapi_events(struct nvkms_per_open *popen)
+{
+    if (popen == NULL || popen->type != NVKMS_CLIENT_KERNEL_SPACE) {
+        return;
+    }
+    WRITE_ONCE(popen->u.kernel.device, NULL);
+    nv_kthread_q_flush(&nvkms_kthread_q);
+}
